# Server-only configuration. Never expose these values with a NEXT_PUBLIC_ prefix.
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Use the pooled Neon/PostgreSQL connection string for app requests.
DATABASE_URL=
NXG_COMPANY_ID=

# Optional SMTP delivery. Configure and verify a sender before enabling outbound mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
CONTACT_TO_EMAIL=
