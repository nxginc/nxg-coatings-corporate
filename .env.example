NEXT_PUBLIC_SITE_URL=https://nxgcoatingsinc.com
NEXT_PUBLIC_CAMPAIGN_HOST=go.nxgcoatingsinc.com
NXG_COMPANY_ID=nxg-coatings
NXG_COMPANY_NAME=NXG Coatings Inc.
NXG_REGION=us-mn
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Optional direct connection for migrations and administrative tasks.
DATABASE_URL_UNPOOLED=

# Generate a 32-byte hex AUTH_SECRET and keep all values server-side.
AUTH_SECRET=replace-with-a-random-64-character-hex-secret
ADMIN_EMAIL=admin@nxgcoatingsinc.com
# Format: salt:64-byte-scrypt-hash-in-hex. Never store a plain-text password.
ADMIN_PASSWORD_HASH=replace-with-random-salt:replace-with-128-hex-characters

# Optional server-to-server CRM access token.
CRM_API_TOKEN=replace-with-a-long-random-token

# Optional contact notification delivery. For Mailtrap, use the SMTP host and
# credentials from its Email Sending settings; its API token is not used here.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@nxgcoatingsinc.com
CONTACT_TO_EMAIL=info@nxgcoatingsinc.com

# Configure when HubSpot synchronization and social publishing are enabled.
HUBSPOT_PRIVATE_APP_TOKEN=
VISTA_SOCIAL_API_TOKEN=
VISTA_SOCIAL_WORKSPACE_ID=

# CMS delivery and media providers. Values are read only on the server.
CONTENTSTACK_API_KEY=
CONTENTSTACK_DELIVERY_TOKEN=
CONTENTSTACK_MANAGEMENT_TOKEN=
CONTENTSTACK_ENVIRONMENT=
CONTENTSTACK_REGION=us
CONTENTSTACK_LOCALE=en-us
CONTENTSTACK_BLOG_CONTENT_TYPE_UID=blog_post
CONTENTSTACK_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternatively, provide CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>.
CLOUDINARY_URL=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Meta Pages and Google Business Profile OAuth. Access/refresh tokens are stored
# encrypted in Postgres after the admin authorizes the provider.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TELNYX_API_KEY=